# ============================================================
# Grocery Getter — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp backend/.env.example backend/.env
#
# The app reads these at startup. Never commit .env to git.
# ============================================================

# ------------------------------------------------------------
# Database (required)
# ------------------------------------------------------------
# Local Homebrew PostgreSQL (default — no password needed):
DATABASE_URL=postgresql+asyncpg://localhost/grocery_getter

# If you have a username/password:
# DATABASE_URL=postgresql+asyncpg://username:password@localhost/grocery_getter

# Supabase (production / remote testing) — uses connection pooler on port 6543:
# DATABASE_URL=postgresql+asyncpg://postgres.yatddebhvwcnfldhppyw:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
#
# To switch to remote: comment out the localhost line above and uncomment the Supabase line.
# Get your password from: Supabase → Settings → Database → Reset database password

# ------------------------------------------------------------
# JWT Secret Key (required)
# ------------------------------------------------------------
# Generate one with:
#   /opt/homebrew/bin/python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ------------------------------------------------------------
# Photo Storage — S3-compatible (optional for MVP)
# ------------------------------------------------------------
# Leave these blank to disable photo uploads.
# Products can still be created without photos.

# Bucket name (Supabase Storage, Cloudflare R2, or AWS S3):
PHOTO_BUCKET_NAME=grocery-getter-photos

# AWS S3 credentials:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Custom endpoint for Supabase Storage or Cloudflare R2:
# Supabase example: https://<project-ref>.supabase.co/storage/v1/s3
# Cloudflare R2 example: https://<account-id>.r2.cloudflarestorage.com
PHOTO_ENDPOINT_URL=

# ------------------------------------------------------------
# CORS — allowed frontend origins (optional, for production)
# ------------------------------------------------------------
# Comma-separated list of frontend URLs to allow.
# Add your Vercel URL here once deployed:
# ALLOWED_ORIGINS=https://grocery-getter.vercel.app
ALLOWED_ORIGINS=
